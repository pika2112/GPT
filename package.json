{
  "name": "sistema-chamadas-loja",
  "version": "2.0.1",
  "description": "Chamadas de atendimento com histórico persistente",
  "main": "desktop.js",
  "scripts": {
    "start": "node servidor.js",
    "test": "node --test test/*.test.js",
    "desktop": "electron .",
    "build:win": "electron-builder --win portable --x64",
    "build:installer": "electron-builder --win nsis --x64",
    "build:folder": "electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "pt.loja.sistema-chamadas",
    "productName": "Sistema de Chamadas",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop.js",
      "preload.js",
      "servidor.js",
      "public/**/*",
      "assets/**/*",
      "package.json",
      "scripts/*.js"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/app.ico",
      "artifactName": "Sistema-Chamadas-${version}-Windows.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "Sistema-Chamadas-${version}-Windows.${ext}"
    },
    "compression": "normal"
  }
}
